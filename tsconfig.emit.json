{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "rootDir": ".",
    "outDir": ".",
    "noEmitOnError": true,
    "strict": true,
    "skipLibCheck": true,
    "removeComments": false,
    "declaration": false
  },
  "files": [
    "js/core/session.ts",
    "js/core/api.ts",
    "js/core/storage.ts",
    "js/agent/agentsvc.ts",
    "js/agent/context.ts",
    "js/agent/ai.ts",
    "js/agent/display.ts",
    "js/agent/riskdetect.ts",
    "js/agent/decision.ts"
  ]
}
