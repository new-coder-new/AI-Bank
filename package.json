{
  "name": "ai-banking-agent",
  "version": "1.0.0",
  "description": "AI 智能金融助手 · 单端口部署（前端 + 模拟银行核心后端）",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "vite",
    "build": "npm run build:ts && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.strict-all.json && npm run build:ts",
    "test": "node tests/run-all.js",
    "build:ts": "tsc -p tsconfig.emit.json",
    "typecheck:strict": "tsc -p tsconfig.strict-all.json",
    "prestart": "npm run build:ts",
    "predev": "npm run build:ts",
    "pretest": "npm run build:ts",
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
    "demo:record": "node scripts/auto-demo.mjs",
    "demo:record:android": "node scripts/auto-demo.mjs --android",
    "demo:check": "node scripts/auto-demo.mjs --fast"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
