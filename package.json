{
  "name": "ai-banking-agent",
  "version": "1.0.0",
  "description": "AI 智能金融助手 · 单端口部署（前端 + 模拟银行核心后端）",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "vite",
    "build": "npm run build:ts && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run build:ts",
    "test": "node tests/run-all.js",
    "build:ts": "tsc -p tsconfig.emit.json && tsc -p tsconfig.emit-loose.json"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
