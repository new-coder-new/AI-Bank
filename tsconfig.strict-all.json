{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "alwaysStrict": false
  },
  "include": [
    "types/**/*.d.ts",
    "js/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "preview",
    "js/**/*.js"
  ]
}
