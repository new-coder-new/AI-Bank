{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "types/**/*.d.ts",
    "js/**/*.js",
    "js/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "preview",
    "js/core/session.js",
    "js/core/api.js",
    "js/core/storage.js",
    "js/agent/agentsvc.js",
    "js/agent/context.js",
    "js/agent/ai.js",
    "js/agent/display.js",
    "js/agent/riskdetect.js",
    "js/agent/decision.js",
    "js/agent/scenario.js",
    "js/agent/planner.js",
    "js/agent/profile.js",
    "js/agent/insights.js",
    "js/agent/agent-llm.js",
    "js/agent/agent-llm.ts",
    "js/agent/kb.js",
    "js/agent/kb.ts",
    "js/agent/agent.js",
    "js/flows/guide-rules.js",
    "js/flows/guide-rules.ts",
    "js/flows/guide-ai.js",
    "js/flows/guide-ai.ts",
    "js/flows/guide-menu.js",
    "js/flows/guide-menu.ts",
    "js/flows/guide-transfer.js",
    "js/flows/guide-transfer.ts",
    "js/flows/guide-wealth.js",
    "js/flows/guide-wealth.ts",
    "js/flows/guide-sub.js",
    "js/flows/guide-sub.ts",
    "js/flows/guide-flower.js",
    "js/flows/guide-flower.ts",
    "js/flows/guide-card.js",
    "js/flows/guide-card.ts"
  ]
}
